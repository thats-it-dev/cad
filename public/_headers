# Cloudflare Pages headers. The CSP allows only this origin and the kit.
# Apps that need more (atproto, a local model) add origins to connect-src.
# cad: the CAD kernel is opencascade.js in a module worker. It needs eval to instantiate the wasm, and it
# creates its worker from a blob URL because importScripts does not exist in a module worker.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://kit.thatsit.app; style-src 'self' 'unsafe-inline' https://kit.thatsit.app; font-src https://kit.thatsit.app; img-src 'self' data: blob:; connect-src 'self' blob: https://kit.thatsit.app; manifest-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed file names, so they never change. Pages merges matching blocks, so /* still applies here.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
